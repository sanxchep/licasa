# The Qt 6.11 lab stages one private, demand-loaded JPEG-only codec.
find_path(UHDR_INCLUDE_DIR NAMES ultrahdr_api.h REQUIRED)
find_library(UHDR_LIBRARY NAMES uhdr REQUIRED)
find_program(LICASA_HDR_READELF NAMES readelf REQUIRED NO_CMAKE_FIND_ROOT_PATH)
file(SHA256 "${UHDR_INCLUDE_DIR}/ultrahdr_api.h" uhdr_header_sha256)
if(NOT uhdr_header_sha256 STREQUAL "dce778b1433375f0713df8b04fb5f8312a22b3d4dc84c29f9289486ac04d33a9")
    message(FATAL_ERROR "The HDR viewer requires the pinned libultrahdr 2.0.2 source headers")
endif()

function(licasa_hdr_elf path out)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env LC_ALL=C "${LICASA_HDR_READELF}" -Wd "${path}"
            OUTPUT_VARIABLE elf RESULT_VARIABLE status ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Cannot inspect HDR runtime ELF ${path}: ${error}")
    endif()
    set(${out} "${elf}" PARENT_SCOPE)
endfunction()

if(NOT TARGET Qt6::QJpegPlugin)
    message(FATAL_ERROR "The HDR lab requires Qt's shared JPEG reader and its matching JPEG ABI")
endif()
get_target_property(qt_jpeg_configs Qt6::QJpegPlugin IMPORTED_CONFIGURATIONS)
set(qt_jpeg_sonames)
foreach(config IN LISTS qt_jpeg_configs)
    get_target_property(qt_jpeg_plugin Qt6::QJpegPlugin "IMPORTED_LOCATION_${config}")
    licasa_hdr_elf("${qt_jpeg_plugin}" qt_jpeg_elf)
    string(REGEX MATCHALL "NEEDED[^\n]*\\[libjpeg\\.so\\.[0-9]+\\]" qt_jpeg_needed "${qt_jpeg_elf}")
    if(NOT qt_jpeg_needed)
        message(FATAL_ERROR "No shared JPEG SONAME found in ${qt_jpeg_plugin}")
    endif()
    foreach(entry IN LISTS qt_jpeg_needed)
        string(REGEX MATCH "libjpeg\\.so\\.[0-9]+" soname "${entry}")
        list(APPEND qt_jpeg_sonames "${soname}")
    endforeach()
endforeach()
list(REMOVE_DUPLICATES qt_jpeg_sonames)
list(LENGTH qt_jpeg_sonames qt_jpeg_count)
if(NOT qt_jpeg_count EQUAL 1)
    message(FATAL_ERROR "The Qt JPEG readers must share exactly one JPEG SONAME")
endif()

licasa_hdr_elf("${UHDR_LIBRARY}" uhdr_elf)
if(NOT uhdr_elf MATCHES "SONAME[^\n]*\\[libuhdr\\.so\\.2\\]" OR uhdr_elf MATCHES "\\((RPATH|RUNPATH)\\)")
    message(FATAL_ERROR "Use a shared libuhdr.so.2 without a runtime search path")
endif()
string(REGEX MATCHALL "NEEDED[^\n]*\\[[^]\n]+\\]" uhdr_needed "${uhdr_elf}")
set(uhdr_uses_qt_jpeg FALSE)
foreach(entry IN LISTS uhdr_needed)
    string(REGEX REPLACE ".*\\[([^]]+)\\].*" "\\1" dependency "${entry}")
    if(dependency STREQUAL qt_jpeg_sonames)
        set(uhdr_uses_qt_jpeg TRUE)
    elseif(dependency MATCHES "^libasan\\.so\\.[0-9]+$" AND LICASA_SANITIZER MATCHES "address")
        continue()
    elseif(dependency MATCHES "^libubsan\\.so\\.[0-9]+$" AND LICASA_SANITIZER MATCHES "undefined")
        continue()
    elseif(NOT dependency MATCHES "^lib(c|m|stdc\\+\\+|gcc_s|pthread)\\.so\\.[0-9]+$")
        message(FATAL_ERROR "Unexpected HDR codec dependency ${dependency}; Qt requires ${qt_jpeg_sonames}")
    endif()
endforeach()
if(NOT uhdr_uses_qt_jpeg)
    message(FATAL_ERROR "Rebuild libultrahdr against Qt's shared ${qt_jpeg_sonames}")
endif()

set(uhdr_stage "${CMAKE_CURRENT_BINARY_DIR}/plugins/gainmap/libuhdr.so.2")
configure_file("${UHDR_LIBRARY}" "${uhdr_stage}" COPYONLY)
install(FILES "${uhdr_stage}" DESTINATION "${LICASA_PLUGIN_INSTALL_DIR}/gainmap")
set(uhdr_notices "${CMAKE_INSTALL_DATADIR}/licenses/licasa/libultrahdr")
foreach(notice LICENSE third_party/image_io/LICENSE adobe-hdr-gain-map-license/NOTICE)
    if(NOT EXISTS "${UHDR_INCLUDE_DIR}/${notice}")
        message(FATAL_ERROR "Use the full pinned libultrahdr source tree; missing ${notice}")
    endif()
endforeach()
install(FILES "${UHDR_INCLUDE_DIR}/LICENSE" DESTINATION "${uhdr_notices}")
install(FILES "${UHDR_INCLUDE_DIR}/third_party/image_io/LICENSE"
        DESTINATION "${uhdr_notices}" RENAME LICENSE-image-io)
install(FILES "${UHDR_INCLUDE_DIR}/adobe-hdr-gain-map-license/NOTICE"
        DESTINATION "${uhdr_notices}" RENAME NOTICE-adobe-gain-map)
