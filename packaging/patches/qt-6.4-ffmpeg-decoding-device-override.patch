+            for (int i = 0; const auto *config = avcodec_get_hw_config(codec, i); ++i) {
+                if (config->device_type == type) {
+                    if (auto *context = loadHWContext(type))
+                        return context;
+                    break;
+                }
+            }
+        }
+        return nullptr;
+    }
 
