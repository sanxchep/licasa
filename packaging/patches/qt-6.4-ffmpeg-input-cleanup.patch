 using namespace QFFmpeg;
 
+// QIODevice-backed AVIO is caller-owned, including its possibly replaced buffer.
+static void freeCustomIO(AVIOContext *io)
+{
+    if (!io)
+        return;
+    av_freep(&io->buffer);
+    avio_context_free(&io);
+}
+
+static void closeInput(AVFormatContext *&context)
+{
+    AVIOContext *io = context && (context->flags & AVFMT_FLAG_CUSTOM_IO)
+            ? context->pb : nullptr;
+    avformat_close_input(&context);
+    freeCustomIO(io);
+}
+
 Q_LOGGING_CATEGORY(qLcDemuxer, "qt.multimedia.ffmpeg.demuxer")
 Q_LOGGING_CATEGORY(qLcDecoder, "qt.multimedia.ffmpeg.decoder")
