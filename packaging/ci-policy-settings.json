{
  "schema_version": 1,
  "repository": "sanxchep/licasa",
  "main_branch": "main",
  "required_checks": [
    "Required verification complete",
    "Check public repository files"
  ],
  "branch_rule": {
    "require_pull_request": true,
    "required_approving_review_count": 0,
    "require_conversation_resolution": true,
    "strict_status_checks": true,
    "allow_force_pushes": false,
    "allow_deletions": false,
    "enforce_admins": true
  },
  "workflow_permissions": {
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false
  },
  "fork_approval": "all_external_contributors",
  "artifact_retention_days": 90,
  "publication_environment": {
    "name": "snap-beta",
    "reviewer_login": "sanxchep",
    "reviewer_id": 32956082,
    "prevent_self_review": false,
    "allow_admin_bypass": false
  },
  "merge_queue_enabled": false,
  "schedule_utc": {
    "nightly": "17 2 * * 1-6",
    "weekly_cold": "43 3 * * 0"
  },
  "activation": "Apply only after reviewed workflow source is deployed and real check producers are validated. Preserve existing stronger protections.",
  "prohibited_commit_message_pattern": "(?i)\\[(skip ci|ci skip|no ci|skip actions|actions skip)\\]|skip-checks:\\s*true"
}
